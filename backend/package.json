{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:dev:deploy": "pnpm dlx prisma migrate deploy",
    "prisma:dev:migrate": "pnpm dlx prisma migrate dev",
    "db:dev:restart": "pnpm run db:dev:rm && pnpm run db:dev:up && sleep 1 && pnpm run prisma:dev:deploy",
    "db:dev:rm": "docker compose rm dev-db -s -f -v",
    "db:dev:up": "docker compose up dev-db -d",
    "prisma:test:deploy": "dotenv -e .env.test.local && pnpm dlx prisma migrate deploy",
    "db:test:restart": "pnpm run db:test:rm && pnpm run db:test:up && sleep 1 && pnpm run prisma:test:deploy",
    "db:test:rm": "docker compose rm test-db -s -f -v",
    "db:test:up": "docker compose up test-db -d",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "tsc:scripts:dev": "tsc scripts/* --skipLibCheck",
    "scripts:generate_compendium:build": "node dist/scripts/generate_compendium.js",
    "scripts:generate_compendium:dev": "node scripts/generate_compendium.js",
    "postbuild": "pnpm run scripts:generate_compendium:build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "dotenv -e .env.test.local && jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.4",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "@tidyjs/tidy": "^2.5.2",
    "argon2": "^0.44.0",
    "axios": "^1.13.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.20",
    "helmet": "^8.1.0",
    "just-memoize": "^2.2.0",
    "prisma": "7.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.5.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.16",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.15.18",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "pactum": "^3.9.1",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "prisma"
    ],
    "overrides": {
      "tough-cookie@<4.1.3": ">=4.1.3",
      "form-data@<2.5.4": ">=2.5.4",
      "qs@<6.14.1": ">=6.14.1",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "diff@<4.0.4": ">=4.0.4",
      "hono@<4.11.7": ">=4.11.7",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "webpack@>=5.49.0 <=5.104.0": ">=5.104.1",
      "webpack@>=5.49.0 <5.104.0": ">=5.104.0",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "axios@>=1.0.0 <=1.13.4": ">=1.13.5",
      "hono@<4.11.10": ">=4.11.10",
      "ajv@<6.14.0": ">=6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1"
    },
    "onlyBuiltDependencies": [
      "argon2"
    ]
  }
}
