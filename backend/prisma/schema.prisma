generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  passwordHash      String
  avatarUrl         String            @default("/default-avatar.jpg")
  firstName         String
  lastName          String
  phone             String?
  role              UserRole          @default(USER)
  isVerified        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  weight            Float // will be stored in kg
  height            Float
  bmi               Float
  unitPref          UserUnitPreference            @default(METRIC) // User display calculations unit preference (how calculation results appear to the user in the frontend)
  workoutLogs       WorkoutLog[]
  workoutTemplates  WorkoutTemplate[]
  fitnessGoals      FitnessGoal[]
  savedExercises    Exercises[]
  createdCategories WorkoutCategory[]
}

model WorkoutTemplate {
  id           Int               @id @default(autoincrement())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  templateName String            @unique
  description  String            @unique
  routine      Json              @db.JsonB
  duration     Int
  notes        String?
  userId       Int
  user         User              @relation(fields: [userId], references: [id])
  categories   WorkoutCategory[]
}

model WorkoutLog {
  id                   Int               @id @default(autoincrement())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  title                String            @unique
  description          String            @unique
  routine              Json              @db.JsonB
  duration             Int
  notes                String?
  estimatedCalorieBurn Int
  userId               Int
  user                 User              @relation(fields: [userId], references: [id])
  categories           WorkoutCategory[]
}

model WorkoutCategory {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  userId     Int
  templateId Int?
  user       User             @relation(fields: [userId], references: [id])
  templates  WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs       WorkoutLog[]
}

model FitnessGoal {
  id            Int        @id @default(autoincrement())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  title         String     @unique
  description   String     @unique
  weightLoss    Int? // stored in kg
  calorieBurn   Int? // stored in kg
  distance      Int? // stored in km
  completeBy    DateTime
  daysRemaining Int
  progress      Float      @default(0.0)
  status        GoalStatus @default(NOT_STARTED)
  subgoals      Json?      @db.JsonB
  userId        Int
  user          User       @relation(fields: [userId], references: [id])
}

model Exercises {
  id        Int     @id @default(autoincrement())
  name      String
  custom    Boolean
  type      String
  muscle    String
  equipment String
  notes     String?
  useCount  Int     @default(0)
  met       String
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum UserUnitPreference {
  IMPERIAL
  METRIC
}
