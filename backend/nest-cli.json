{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "compendium/data/2024_Adult_Compendium_MET.csv",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "compendium/data/compendium.csv",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "../generated/*",
        "outDir": "dist/generated",
        "watchAssets": true
      }
    ]    
  }
}